FROM python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
RUN groupadd --system app && useradd --system --gid app --create-home app
WORKDIR /app
COPY prototype/api/requirements.txt /tmp/requirements.txt
RUN python -m pip install --upgrade pip && \
    python -m pip install -r /tmp/requirements.txt && \
    python -m pip uninstall -y pip setuptools
COPY --chown=app:app prototype /app/prototype
COPY --chown=app:app data /app/data
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD awk '$2 ~ /:1F40$/ && $4 == "0A" {found=1} END{exit !found}' /proc/net/tcp
CMD ["uvicorn", "prototype.api.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
