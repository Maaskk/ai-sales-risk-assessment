FROM python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
RUN groupadd --system app && useradd --system --gid app --create-home app
WORKDIR /app
COPY prototype/api/requirements.txt prototype/api/requirements-trainer.txt /tmp/
RUN python -m pip install --upgrade pip && \
    python -m pip install -r /tmp/requirements-trainer.txt && \
    python -m pip uninstall -y pip setuptools
COPY --chown=app:app prototype /app/prototype
COPY --chown=app:app data /app/data
RUN mkdir -p /app/model && chown app:app /app/model
USER app
HEALTHCHECK NONE
CMD ["python", "prototype/model/train.py"]
